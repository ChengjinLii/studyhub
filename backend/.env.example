STUDYHUB_ENVIRONMENT=local-dev
STUDYHUB_HOST=127.0.0.1
STUDYHUB_PORT=8011
STUDYHUB_LOG_LEVEL=INFO
# docker compose 推荐：
# STUDYHUB_DATABASE_URL=mysql+pymysql://studyhub:studyhub@mysql:3306/studyhub?charset=utf8mb4
# STUDYHUB_LOCAL_DEV_ROOT_DIR=/workspace/.local-dev
#
# shell quickstart 推荐：
# STUDYHUB_LOCAL_DEV_ROOT_DIR=/root/StudyHub-FastAPI/.local-dev
# STUDYHUB_LOCAL_DEV_BOOTSTRAP_USER=true
# STUDYHUB_LOCAL_DEV_QUICK_LOGIN_ENABLED=true
# STUDYHUB_LOCAL_DEV_USER_ID=900001
# STUDYHUB_LOCAL_DEV_USERNAME=developer
# STUDYHUB_LOCAL_DEV_PASSWORD=developer123
# STUDYHUB_LOCAL_DEV_NICKNAME=开发者
# STUDYHUB_LOCAL_DEV_EMAIL=developer@local.studyhub.dev
# STUDYHUB_LOCAL_DEV_ROLE_MASK=1
# STUDYHUB_MAIL_PROVIDER=local_outbox
# STUDYHUB_STORAGE_PROVIDER=local_fs
# STUDYHUB_PAYMENT_PROVIDER=local_alipay
# STUDYHUB_DATABASE_URL=sqlite+pysqlite:////root/StudyHub-FastAPI/.local-dev/studyhub_fastapi.sqlite3
# STUDYHUB_MATERIAL_ASSET_DIR=/root/StudyHub-FastAPI/.local-dev/materials
# STUDYHUB_MARKET_ASSET_DIR=/root/StudyHub-FastAPI/.local-dev/market
# STUDYHUB_PAYOUT_QR_ASSET_DIR=/root/StudyHub-FastAPI/.local-dev/payout-qr
# STUDYHUB_MAIL_OUTBOX_DIR=/root/StudyHub-FastAPI/.local-dev/outbox/mail
# STUDYHUB_PLATFORM_COMMISSION_RATE=0.10
# STUDYHUB_REQUEST_COMMISSION_RATE=0.05
# STUDYHUB_SETTLEMENT_PAYOUT_DELAY_DAYS=7
# MCP is anonymous in local-dev unless auth is explicitly enabled.
# STUDYHUB_MCP_ENABLED=true
# STUDYHUB_MCP_REQUIRE_AUTH=true
# STUDYHUB_MCP_AUTH_MODE=static
# STUDYHUB_MCP_ACCESS_TOKENS=local-agent-token:studyhub.read
# STUDYHUB_MCP_CLIENT_RATE_LIMIT=60
# STUDYHUB_MCP_CLIENT_QUOTA=1000
# STUDYHUB_MCP_CLIENT_QUOTA_WINDOW_SECONDS=86400
# New Agentic Platform is isolated from the existing /api/ai-* assistant.
# Keep every external capability disabled until the administrator-only platform is deployed.
STUDYHUB_AGENTIC_PLATFORM_ENABLED=false
STUDYHUB_AGENTIC_ADMIN_ONLY=true
STUDYHUB_AGENTIC_RUNTIME=legacy
STUDYHUB_AGENTIC_CHECKPOINTER=sqlite
STUDYHUB_AGENTIC_TRANSITION_EXPORT_ENABLED=true
# Shadow Mode is opt-in and only writes reviewable artifacts for this admin.
# It never sends learner-facing notifications or changes learner plans.
STUDYHUB_AGENTIC_PROACTIVE_ENABLED=false
# STUDYHUB_AGENTIC_SHADOW_ADMIN_ACTOR_ID=3
STUDYHUB_AGENTIC_WORKER_LOCK_NAME=studyhub:agentic
STUDYHUB_AGENTIC_WORKER_LOCK_TIMEOUT_SECONDS=10
STUDYHUB_AGENTIC_WORKER_BATCH_SIZE=8
STUDYHUB_AGENTIC_WORKER_CLAIM_TTL_SECONDS=300
STUDYHUB_AGENTIC_WORKER_RETRY_DELAY_SECONDS=60
STUDYHUB_AGENTIC_WORKER_MAX_ATTEMPTS=3
# General AgentKernel/DeepResearch execution is a separate, disabled-by-default
# worker plane. It is intentionally not included in the normal all job.
STUDYHUB_AGENTIC_EXECUTION_ENABLED=false
STUDYHUB_AGENTIC_EXECUTION_BATCH_SIZE=4
STUDYHUB_AGENTIC_EXECUTION_CLAIM_TTL_SECONDS=900
STUDYHUB_AGENTIC_EXECUTION_MAX_ATTEMPTS=3
# Required before turning on execution: model data is persisted through SQL
# metadata plus immutable fsync'd Artifact/Transition segments.  Use `oss` in
# production; never point this at a public download directory.
STUDYHUB_AGENTIC_DURABLE_STORAGE_ENABLED=false
STUDYHUB_AGENTIC_ARTIFACT_STORAGE_PROVIDER=local_fs
# STUDYHUB_AGENTIC_ARTIFACT_ROOT_DIR=/srv/studyhub/private/agentic-platform
# Model settings are isolated from the old AiService. Never commit a real key.
STUDYHUB_AGENTIC_MODEL_PROVIDER=disabled
# STUDYHUB_AGENTIC_MODEL_BASE_URL=https://api.example.invalid/v1
# STUDYHUB_AGENTIC_MODEL_API_KEY=
# STUDYHUB_AGENTIC_MODEL_ID=
# STUDYHUB_AGENTIC_MODEL_REVISION=
STUDYHUB_AGENTIC_MODEL_TIMEOUT_SECONDS=30
STUDYHUB_AGENTIC_MODEL_MAX_RETRIES=2
# teacher_api never fabricates local tokenizer IDs; use local only for a
# provider that returns its own native token IDs and role spans.
STUDYHUB_AGENTIC_MODEL_TOKEN_TRACE_SOURCE=teacher_api
STUDYHUB_DEEP_RESEARCH_ENABLED=false
STUDYHUB_DEEP_RESEARCH_WEB_ENABLED=false
STUDYHUB_DEEP_RESEARCH_SCHOLAR_ENABLED=false
STUDYHUB_DEEP_RESEARCH_PYTHON_ENABLED=false
STUDYHUB_AGENTIC_MAX_TURNS=8
STUDYHUB_AGENTIC_MAX_SKILL_CALLS=12
STUDYHUB_DEEP_RESEARCH_MAX_SEARCH_TURNS=4
STUDYHUB_DEEP_RESEARCH_MAX_PAGE_READS=10
STUDYHUB_AGENTIC_MAX_CONTEXT_TOKENS=16000
