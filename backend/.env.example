STUDYHUB_ENVIRONMENT=local-dev
STUDYHUB_HOST=127.0.0.1
STUDYHUB_PORT=8011
STUDYHUB_LOG_LEVEL=INFO
# docker compose 推荐：
# STUDYHUB_DATABASE_URL=mysql+pymysql://studyhub:studyhub@mysql:3306/studyhub?charset=utf8mb4
# STUDYHUB_LOCAL_DEV_ROOT_DIR=/workspace/.local-dev
#
# shell quickstart 推荐：
# STUDYHUB_LOCAL_DEV_ROOT_DIR=/root/StudyHub-FastAPI/.local-dev
# STUDYHUB_LOCAL_DEV_BOOTSTRAP_USER=true
# STUDYHUB_LOCAL_DEV_QUICK_LOGIN_ENABLED=true
# STUDYHUB_LOCAL_DEV_USER_ID=900001
# STUDYHUB_LOCAL_DEV_USERNAME=developer
# STUDYHUB_LOCAL_DEV_PASSWORD=developer123
# STUDYHUB_LOCAL_DEV_NICKNAME=开发者
# STUDYHUB_LOCAL_DEV_EMAIL=developer@local.studyhub.dev
# STUDYHUB_LOCAL_DEV_ROLE_MASK=1
# STUDYHUB_MAIL_PROVIDER=local_outbox
# STUDYHUB_STORAGE_PROVIDER=local_fs
# STUDYHUB_PAYMENT_PROVIDER=local_alipay
# STUDYHUB_DATABASE_URL=sqlite+pysqlite:////root/StudyHub-FastAPI/.local-dev/studyhub_fastapi.sqlite3
# STUDYHUB_MATERIAL_ASSET_DIR=/root/StudyHub-FastAPI/.local-dev/materials
# STUDYHUB_MARKET_ASSET_DIR=/root/StudyHub-FastAPI/.local-dev/market
# STUDYHUB_PAYOUT_QR_ASSET_DIR=/root/StudyHub-FastAPI/.local-dev/payout-qr
# STUDYHUB_MAIL_OUTBOX_DIR=/root/StudyHub-FastAPI/.local-dev/outbox/mail
# STUDYHUB_PLATFORM_COMMISSION_RATE=0.30
# STUDYHUB_SETTLEMENT_PAYOUT_DELAY_DAYS=7
