STUDYHUB_ENVIRONMENT=local-dev
STUDYHUB_HOST=127.0.0.1
STUDYHUB_PORT=8011
STUDYHUB_LOG_LEVEL=INFO
# docker compose 推荐：
# STUDYHUB_DATABASE_URL=mysql+pymysql://studyhub:studyhub@mysql:3306/studyhub?charset=utf8mb4
# STUDYHUB_LOCAL_DEV_ROOT_DIR=/workspace/.local-dev
#
# shell quickstart 推荐：
# STUDYHUB_LOCAL_DEV_ROOT_DIR=/root/StudyHub-FastAPI/.local-dev
# STUDYHUB_LOCAL_DEV_BOOTSTRAP_USER=true
# STUDYHUB_LOCAL_DEV_QUICK_LOGIN_ENABLED=true
# STUDYHUB_LOCAL_DEV_USER_ID=900001
# STUDYHUB_LOCAL_DEV_USERNAME=developer
# STUDYHUB_LOCAL_DEV_PASSWORD=developer123
# STUDYHUB_LOCAL_DEV_NICKNAME=开发者
# STUDYHUB_LOCAL_DEV_EMAIL=developer@local.studyhub.dev
# STUDYHUB_LOCAL_DEV_ROLE_MASK=1
# STUDYHUB_MAIL_PROVIDER=local_outbox
# STUDYHUB_STORAGE_PROVIDER=local_fs
# STUDYHUB_PAYMENT_PROVIDER=local_alipay
# STUDYHUB_DATABASE_URL=sqlite+pysqlite:////root/StudyHub-FastAPI/.local-dev/studyhub_fastapi.sqlite3
# STUDYHUB_MATERIAL_ASSET_DIR=/root/StudyHub-FastAPI/.local-dev/materials
# STUDYHUB_MARKET_ASSET_DIR=/root/StudyHub-FastAPI/.local-dev/market
# STUDYHUB_PAYOUT_QR_ASSET_DIR=/root/StudyHub-FastAPI/.local-dev/payout-qr
# STUDYHUB_MAIL_OUTBOX_DIR=/root/StudyHub-FastAPI/.local-dev/outbox/mail
# STUDYHUB_PLATFORM_COMMISSION_RATE=0.10
# STUDYHUB_REQUEST_COMMISSION_RATE=0.05
# STUDYHUB_SETTLEMENT_PAYOUT_DELAY_DAYS=7
# Production short-lived security state. Keep real credentials in private/.env.production only.
# STUDYHUB_ABUSE_MONITOR_ALERT_EMAILS=admin@example.com,ops@example.com
# STUDYHUB_REDIS_URL=redis://studyhub:replace-me@127.0.0.1:6379/0
# STUDYHUB_RATE_LIMIT_BACKEND=redis
# STUDYHUB_RATE_LIMIT_COMMENT_CREATE_USER_MINUTE=6
# STUDYHUB_RATE_LIMIT_COMMENT_CREATE_USER_HOUR=30
# STUDYHUB_RATE_LIMIT_COMMENT_CREATE_IP_MINUTE=60
# STUDYHUB_RATE_LIMIT_COMMENT_ACTION_USER_MINUTE=30
# STUDYHUB_RATE_LIMIT_COMMENT_REPORT_USER_HOUR=10
# STUDYHUB_RATE_LIMIT_COMMENT_DUPLICATE_SECONDS=300
# STUDYHUB_COMMENTS_WRITE_ENABLED=true
# STUDYHUB_CAPTCHA_BACKEND=redis
# STUDYHUB_SECURITY_STATE_BACKEND=redis
# STUDYHUB_PUBLIC_READ_CACHE_BACKEND=redis
# STUDYHUB_UPLOAD_AUTHORIZATION_REQUIRED=true
# STUDYHUB_UPLOAD_DAILY_SUBMISSION_LIMIT=50
# STUDYHUB_UPLOAD_DAILY_BYTES_LIMIT=1073741824
# MCP is anonymous in local-dev unless auth is explicitly enabled.
# STUDYHUB_MCP_ENABLED=true
# STUDYHUB_MCP_REQUIRE_AUTH=true
# STUDYHUB_MCP_AUTH_MODE=static
# STUDYHUB_MCP_ACCESS_TOKENS=local-agent-token:studyhub.read
# STUDYHUB_MCP_CLIENT_RATE_LIMIT=60
# STUDYHUB_MCP_CLIENT_QUOTA=1000
# STUDYHUB_MCP_CLIENT_QUOTA_WINDOW_SECONDS=86400
