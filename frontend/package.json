{
  "name": "studyhub-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit --pretty false",
    "check": "npm run typecheck && npm run lint",
    "test:unit": "vitest run tests/unit",
    "format": "prettier --write .",
    "test:smoke": "playwright test tests/smoke.spec.ts",
    "test:critical": "playwright test tests/critical-paths.spec.ts",
    "test:perf": "node scripts/perf-budget.mjs",
    "xmas:hat": "node scripts/vectorize-hat.mjs"
  },
  "dependencies": {
    "imagetracerjs": "^1.2.6",
    "jszip": "^3.10.1",
    "next": "14.2.35",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-markdown": "^9.1.0",
    "react-snowfall": "^2.4.0",
    "remark-gfm": "^4.0.1",
    "svgo": "4.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.47.2",
    "@types/node": "24.10.1",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "eslint": "8.57.0",
    "eslint-config-next": "14.2.35",
    "eslint-config-prettier": "9.1.0",
    "prettier": "3.3.3",
    "typescript": "6.0.3",
    "vitest": "^1.6.1"
  }
}
