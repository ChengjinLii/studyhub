{
  "name": "studyhub-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit --pretty false",
    "typecheck:strict": "tsc --project tsconfig.strict.json --pretty false",
    "check": "npm run typecheck && npm run lint",
    "test:unit": "vitest run tests/unit",
    "format": "prettier --write .",
    "test:smoke": "playwright test tests/smoke.spec.ts",
    "test:critical": "playwright test tests/critical-paths.spec.ts",
    "test:critical:prod": "PLAYWRIGHT_SERVER_MODE=production playwright test tests/critical-paths.spec.ts",
    "test:perf": "node scripts/perf-budget.mjs",
    "xmas:hat": "node scripts/vectorize-hat.mjs"
  },
  "dependencies": {
    "imagetracerjs": "^1.2.6",
    "jszip": "^3.10.1",
    "next": "16.2.7",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-markdown": "^9.1.0",
    "react-snowfall": "^2.4.0",
    "remark-gfm": "^4.0.1",
    "svgo": "4.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.47.2",
    "@types/node": "24.10.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.7",
    "eslint-config-prettier": "9.1.0",
    "prettier": "3.3.3",
    "typescript": "5.4.5",
    "vitest": "^1.6.1"
  }
}
