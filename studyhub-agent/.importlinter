[importlinter]
root_package = studyhub_agent

[importlinter:contract:layers]
name = Agent layers
type = layers
layers =
    studyhub_agent.architectures
    studyhub_agent.runtime
    studyhub_agent.environments
    studyhub_agent.tools
    studyhub_agent.knowledge
    studyhub_agent.guardrails
    studyhub_agent.contracts

[importlinter:contract:knowledge-isolation]
name = Knowledge services do not depend on orchestration or website tools
type = forbidden
source_modules =
    studyhub_agent.knowledge
forbidden_modules =
    studyhub_agent.runtime
    studyhub_agent.architectures
    studyhub_agent.environments
    studyhub_agent.tools

[importlinter:contract:graders]
name = Graders depend only on contracts
type = forbidden
source_modules =
    studyhub_agent.graders
forbidden_modules =
    studyhub_agent.architectures
    studyhub_agent.runtime
    studyhub_agent.environments
    studyhub_agent.tools
    studyhub_agent.knowledge
    studyhub_agent.guardrails
