#!/usr/bin/env bash
set -euo pipefail

LAUNCHER_PATH="$(readlink -f "${BASH_SOURCE[0]}")"
AGENT_ROOT="$(cd "$(dirname "$LAUNCHER_PATH")/.." && pwd)"
WORKSPACE_ROOT="$(cd "$AGENT_ROOT/.." && pwd)"
LOCK_FILE="$AGENT_ROOT/integrations/hermes/upstream.lock.json"
PATCH_FILE="$AGENT_ROOT/integrations/hermes/patches/0001-studyhub-branding.patch"
SKINS_DIR="$AGENT_ROOT/integrations/hermes/skins"

read_lock() {
  python3 -c 'import json, sys; print(json.load(open(sys.argv[1], encoding="utf-8"))[sys.argv[2]])' "$LOCK_FILE" "$1"
}

EXPECTED_COMMIT="$(read_lock commit)"
SIBLING_HERMES="$(cd "$WORKSPACE_ROOT/.." && pwd)/hermes-agent"
VENDORED_HERMES="$AGENT_ROOT/.vendor/hermes-agent"

if [[ -n "${STUDYHUB_HERMES_DIR:-}" ]]; then
  HERMES_DIR="$STUDYHUB_HERMES_DIR"
elif [[ -d "$SIBLING_HERMES/.git" ]]; then
  HERMES_DIR="$SIBLING_HERMES"
else
  HERMES_DIR="$VENDORED_HERMES"
fi

if [[ ! -d "$HERMES_DIR/.git" ]]; then
  printf 'StudyHub Agent: Hermes checkout not found at %s\n' "$HERMES_DIR" >&2
  printf 'Run: %s/scripts/setup-hermes.sh\n' "$AGENT_ROOT" >&2
  exit 2
fi

ACTUAL_COMMIT="$(git -C "$HERMES_DIR" rev-parse HEAD)"
if [[ "$ACTUAL_COMMIT" != "$EXPECTED_COMMIT" ]]; then
  printf 'StudyHub Agent: Hermes commit mismatch.\nExpected: %s\nActual:   %s\n' \
    "$EXPECTED_COMMIT" "$ACTUAL_COMMIT" >&2
  exit 2
fi

if ! git -C "$HERMES_DIR" apply --check --reverse "$PATCH_FILE" >/dev/null 2>&1; then
  printf 'StudyHub Agent: the locked StudyHub Hermes patch is not applied.\n' >&2
  printf 'Run: %s/scripts/setup-hermes.sh %s\n' "$AGENT_ROOT" "$HERMES_DIR" >&2
  exit 2
fi

if [[ -n "${STUDYHUB_HERMES_PYTHON:-}" ]]; then
  HERMES_PYTHON="$STUDYHUB_HERMES_PYTHON"
elif [[ -x "$HERMES_DIR/venv/bin/python" ]]; then
  HERMES_PYTHON="$HERMES_DIR/venv/bin/python"
elif [[ -x "$HERMES_DIR/.venv/bin/python" ]]; then
  HERMES_PYTHON="$HERMES_DIR/.venv/bin/python"
else
  HERMES_PYTHON="python3"
fi

export HERMES_SKIN="studyhub"
export HERMES_SKINS_DIR="$SKINS_DIR"
export STUDYHUB_AGENT_ROOT="$AGENT_ROOT"
export STUDYHUB_ROOT="$WORKSPACE_ROOT"
export PYTHONPATH="$HERMES_DIR${PYTHONPATH:+:$PYTHONPATH}"

cd "$WORKSPACE_ROOT"
exec "$HERMES_PYTHON" -m hermes_cli.main "$@"
