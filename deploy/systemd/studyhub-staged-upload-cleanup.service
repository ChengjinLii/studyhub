[Unit]
Description=Clean abandoned StudyHub staged uploads
After=network-online.target studyhub-backend.service
Wants=network-online.target

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
WorkingDirectory=/data/studyhub-runtime/current/backend
Environment=STUDYHUB_ENVIRONMENT=production
Environment=STUDYHUB_PRIVATE_DIR_PATH=/data/studyhub/private
ExecStart=/data/studyhub-runtime/current/.venv/bin/python -m app.ops.staged_upload_cleanup
Nice=15
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadOnlyPaths=/data/studyhub-runtime /data/studyhub/private
