[Unit]
Description=StudyHub encrypted production database backup
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
WorkingDirectory=/data/studyhub
ExecStart=/data/studyhub/scripts/backup/production-backup.sh
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadOnlyPaths=/data/studyhub
ReadWritePaths=/data/studyhub/private/backups
